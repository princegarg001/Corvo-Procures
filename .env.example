# Copy to .env (never commit .env). All settings are optional for local runs.
# Postgres (Neon / Supabase / Render style URLs are accepted; postgres:// is normalised to psycopg).
DATABASE_URL=postgresql+psycopg://corvo:corvo@localhost:5432/corvo
# LLM providers for reading amendments and chat slots (the app works without them).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=45
APP_TZ=Asia/Kolkata
# Seed master data, contracts (incl. PDF-only), policy v5.0 and the demo batch on start.
SEED_ON_START=true
SEED_DEMO_RUN=true
REGISTER_AS_OF=2026-10-31
MAX_UPLOAD_MB=10
# Pin "today" for demos/tests only (YYYY-MM-DD); leave empty in production.
APP_TODAY=
